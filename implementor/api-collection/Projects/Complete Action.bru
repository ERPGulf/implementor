meta {
  name: Complete Action
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/method/implementor.client_api.complete_action
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  todo: 12glqu2bo8
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("has message", function () {
    expect(res.body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Marks one assigned task as done.
  
  **Endpoint:** `POST /api/method/implementor.client_api.complete_action`  
  **Screen:** Waiting on you → Mark done
  
  > ⚠️ **Changes data** on the shared server. Use test records only.
  
  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned. The task must be assigned to this user.
  
  **Body fields (form-encoded):**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `todo` | string | yes | `12glqu2bo8` | `name` from Waiting for you. |
  | `customer` | string | no | `Hamza` | Client company. Send only when `me.customers` has more than one entry. Disabled by default. |
  
  **Response (trimmed):**
  
  ```json
  { "message": [ ... updated list ... ] }
  ```
  
  **Errors:**
  
  - **401:** Token missing, expired or invalid. Refresh once and retry, else sign out.
  - **403:** Not this client's record, or role not allowed.
  - **404:** Task not found.
}
