meta {
  name: List Projects
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/method/implementor.client_api.get_projects
  body: none
  auth: inherit
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("has message", function () {
    expect(res.body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lists the client's implementation projects.
  
  **Endpoint:** `GET /api/method/implementor.client_api.get_projects`  
  **Screen:** Not in the Mobile UI guide yet
  
  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned.
  
  **Query parameters:**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `customer` | string | no | `Hamza` | Client company. Send only when `me.customers` has more than one entry. Disabled by default. |
  
  **Response (trimmed):**
  
  ```json
  { "message": [ { "name": "PROJ-0029", ... } ] }
  ```
  
  **Errors:**
  
  - **401:** Token missing, expired or invalid. Refresh once and retry, else sign out.
  - **403:** Not this client's record, or role not allowed.
  
  **Notes:**
  
  - New request: `get_projects` is whitelisted but wasn't in the collection. Check the response shape and fill it in here.
}
