meta {
  name: New password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/method/employee_app.gauth.create_new_password
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  new_password: {{password}}
  mobile_no: 1234567891
  otp: 123456
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sets a new password for password-based sign-in.
  
  **Endpoint:** `POST /api/method/employee_app.gauth.create_new_password`
  
  > **From another app:** this endpoint belongs to **employee_app**, not implementor. Its code, fields and errors are owned by the employee_app team. The app calls it through `@erpgulf/auth-sdk`.
  
  > ⚠️ **Changes data** on the shared server. Use test records only.
  
  **Permission:** Master token.
  
  **Body fields (form-encoded):**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `mobile_no` | string | yes | `1234567891` |  |
  | `otp` | string | yes | `123456` | From Generate and send otp. |
  | `new_password` | string | yes | `{{password}}` | From `.env` (`PASSWORD`). |
  
  **Response (trimmed):**
  
  ```json
  { "message": { ... } }
  ```
}
