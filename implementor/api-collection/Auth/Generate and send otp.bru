meta {
  name: Generate and send otp
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/method/employee_app.authentication.generate_and_send_otp
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  mobile_no: 1234567891
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sends an OTP to the user's mobile number during sign-up or sign-in.
  
  **Endpoint:** `POST /api/method/employee_app.authentication.generate_and_send_otp`
  
  > **From another app:** this endpoint belongs to **employee_app**, not implementor. Its code, fields and errors are owned by the employee_app team. The app calls it through `@erpgulf/auth-sdk`.
  
  > ⚠️ **Changes data** on the shared server. Use test records only.
  
  **Permission:** Master token.
  
  **Body fields (form-encoded):**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `mobile_no` | string | yes | `1234567891` |  |
  
  **Response (trimmed):**
  
  ```json
  { "message": { ... } }
  ```
  
  **Notes:**
  
  - Sends a real SMS. Use a test number.
}
