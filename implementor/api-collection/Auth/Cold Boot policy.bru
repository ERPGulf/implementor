meta {
  name: Cold Boot policy
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/method/employee_app.authentication.cold_boot_api
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  password: {{password}}
  otp: 123456
  mobile_no: 1234567891
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Called on app restart. Tells the app whether the user must sign in again.
  
  **Endpoint:** `POST /api/method/employee_app.authentication.cold_boot_api`
  
  > **From another app:** this endpoint belongs to **employee_app**, not implementor. Its code, fields and errors are owned by the employee_app team. The app calls it through `@erpgulf/auth-sdk`.
  
  **Permission:** Master token.
  
  **Body fields (form-encoded):**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `mobile_no` | string | yes | `1234567891` | Use a test number. |
  | `otp` | string | depends on policy | `123456` | From Generate and send otp. |
  | `password` | string | depends on policy | `{{password}}` | From `.env` (`PASSWORD`). Never type a real password here. |
  
  **Response (trimmed):**
  
  ```json
  { "message": { "action": "CONTINUE_SESSION", ... } }
  ```
  
  **Notes:**
  
  - If it returns `CONTINUE_SESSION`, keep the stored session.
  - Which of `otp` and `password` are needed depends on the login policy.
}
