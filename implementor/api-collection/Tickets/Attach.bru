meta {
  name: Attach
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/method/implementor.client_api.upload_ticket_attachment
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  ticket: 12h2sd9uia
  filename: stock_valuation_screenshot.png
  filedata: iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("has message", function () {
    expect(res.body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Uploads a screenshot or recording to a ticket.
  
  **Endpoint:** `POST /api/method/implementor.client_api.upload_ticket_attachment`  
  **Screen:** Raise Ticket / Ticket status
  
  > ⚠️ **Changes data** on the shared server. Use test records only.
  
  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned.
  
  **Body fields (form-encoded):**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `ticket` | string | yes | `12h2sd9uia` |  |
  | `filename` | string | yes | `screenshot.png` | With extension. |
  | `filedata` | base64 | yes | `...` | Max 10 MB. |
  | `customer` | string | no | `Hamza` | Client company. Send only when `me.customers` has more than one entry. Disabled by default. |
  
  **Response (trimmed):**
  
  ```json
  { "message": { "name": "e890f3425b", "file_name": "screenshot.png" } }
  ```
  
  **Errors:**
  
  - **401:** Token missing, expired or invalid. Refresh once and retry, else sign out.
  - **403:** Not this client's record, or role not allowed.
  - **417:** File too large or empty.
  - **404:** Ticket not found.
}
