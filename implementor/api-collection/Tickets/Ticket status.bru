meta {
  name: Ticket status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/method/implementor.client_api.get_ticket?ticket=12hnuea73s
  body: none
  auth: inherit
}

params:query {
  ticket: 12hnuea73s
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("has message", function () {
    expect(res.body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns one ticket with its timeline, comments and attachments.
  
  **Endpoint:** `GET /api/method/implementor.client_api.get_ticket`  
  **Screen:** Ticket status
  
  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned.
  
  **Query parameters:**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `ticket` | string | yes | `12hnuea73s` | Ticket `name`. |
  | `customer` | string | no | `Hamza` | Client company. Send only when `me.customers` has more than one entry. Disabled by default. |
  
  **Response (trimmed):**
  
  ```json
  {
    "message": {
      "name": "...", "subject": "...", "description": "Module: ...\nScreen or document: ...", "status": "Resolved",
      "steps": [ { "label": "...", "state": "done", "at": null } ],
      "assigned_to": [ ... ], "hours_logged": 2.5,
      "comments": [ ... ], "attachments": [ { "name": "e890f3425b", ... } ],
      "needs_confirmation": true
    }
  }
  ```
  
  **Errors:**
  
  - **401:** Token missing, expired or invalid. Refresh once and retry, else sign out.
  - **403:** Not this client's record, or role not allowed.
  - **404:** Ticket not found.
  
  **Notes:**
  
  - Timeline: `done` green check, `current` maroon ring, others grey. `at` can be null.
  - `needs_confirmation` true: show "It is fixed" and "Still an issue".
}
