meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/method/implementor.client_api.me
  body: none
  auth: inherit
}

params:query {
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns message object", function () {
    expect(res.body).to.have.property("message");
    expect(res.body.message).to.be.an("object");
  });

  test("returns user identity fields", function () {
    const message = res.body.message;
    const textOrNull = (value) => typeof value === "string" || value === null;

    expect(message.user).to.be.a("string");
    expect(message.full_name).to.satisfy(textOrNull);
    expect(message.email).to.satisfy(textOrNull);
    expect(message.mobile_no).to.satisfy(textOrNull);
    expect(message.user_image).to.satisfy(textOrNull);
  });

  test("returns client company fields", function () {
    const message = res.body.message;

    expect(message.customer).to.be.a("string");
    expect(message.customer_name).to.satisfy(
      (value) => typeof value === "string" || value === null
    );
    expect(message.is_client_admin).to.be.a("boolean");
  });

  test("returns exactly the agreed response fields", function () {
    const expectedFields = [
      "user",
      "full_name",
      "email",
      "mobile_no",
      "user_image",
      "customer",
      "customer_name",
      "is_client_admin"
    ];
    expect(Object.keys(res.body.message).sort()).to.eql(expectedFields.sort());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns who the signed-in user is, their client company, and whether they are a Client Admin.

  **Endpoint:** `GET /api/method/implementor.client_api.me`  
  **Screen:** Profile. Also call it once after sign-in to decide what to show.

  **Method:** GET only. A POST is refused by Frappe with **403** "Not permitted" and **no** `error_code`.

  **Permission:** Signed-in client user (`Client User` or `Client Admin`).

  **Query parameters:**

  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `customer` | string | no | `Hamza` | Not used by the app. The server selects the user's company. Disabled by default. |

  **Successful response:**

  ```json
  {
    "message": {
      "user": "aisha@hamza.com",
      "full_name": "Aisha Khan",
      "email": "aisha@hamza.com",
      "mobile_no": "+966500000000",
      "user_image": "/files/aisha.jpg",
      "customer": "Hamza",
      "customer_name": "Hamza Trading Co.",
      "is_client_admin": true
    }
  }
  ```

  **Response fields:**

  | Field | Type | Always returned | Notes |
  | --- | --- | --- | --- |
  | `user` | string | Yes | Frappe User ID, normally the email. |
  | `full_name` | string \| null | Yes | User's full name. |
  | `email` | string \| null | Yes | User email. |
  | `mobile_no` | string \| null | Yes | User mobile number. |
  | `user_image` | string \| null | Yes | Relative URL of the profile photo. Prefix it with the base URL. |
  | `customer` | string | Yes | Linked client company ID. Always set: without one, the call fails with `no_client_linked`. |
  | `customer_name` | string \| null | Yes | Client company name. Show this, not `customer`. |
  | `is_client_admin` | boolean | Yes | See below. |

  **`is_client_admin`:**

  - `true`: the user sees every ticket for the company, and can sign off milestones.
  - `false`: the user sees only tickets they raised. Milestones show "Awaiting admin sign-off" with no button.

  **How the server finds the client company:** through the user's Contact. The Contact is matched by its User field, or else by the user's verified email or mobile number, and must be linked to a Customer.

  **Errors:** every error from this API has an `error_code`, except the wrong-method case above.

  - **401:** Token missing, expired, or invalid. Refresh once and retry; otherwise sign out.
  - **403 / `no_client_linked`:** The user isn't linked to any client company. Show a clear support/contact message, not a blank Home screen.
  - **403 / `not_permitted`:** `customer` was sent and isn't the user's company.
  - **404 / `not_found`:** `customer` was sent and doesn't exist.
}
