meta {
  name: Home
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/method/implementor.client_api.home
  body: none
  auth: inherit
}

params:query {
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("has message", function () {
    expect(res.body).to.have.property("message");
  });

  test("has counts and actions, no service lists", function () {
    const m = res.body.message;
    expect(m.tickets).to.have.property("open");
    expect(m.tickets).to.have.property("waiting_for_you");
    expect(m.my_actions).to.be.an("array");
    expect(m.unread_notifications).to.be.a("number");
    expect(m).to.not.have.property("implementations");
    expect(m).to.not.have.property("amc");
    expect(m).to.not.have.property("servers");
  });

  test("action urgency and cta are lowercase codes", function () {
    const isCode = (v) => v === null || /^[a-z0-9_]+$/.test(v);
    res.body.message.my_actions.forEach(function (a) {
      expect(a.urgency).to.satisfy(isCode);
      expect(a.cta).to.be.oneOf(["upload", "sign_off", "mark_done"]);
      expect(a.status).to.equal("open");
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Counts and actions for the Home screen.

  **Endpoint:** `GET /api/method/implementor.client_api.home`  
  **Screen:** Home

  Home makes two calls:

  - `home` (this one): counts and actions
  - `get_services`: the service cards (implementation, AMC, hosting)

  `home` does **not** return `implementations[]`, `amc[]` or `servers[]`. Use `get_services`, so each card has only one source.

  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned.

  **Query parameters:**

  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `customer` | string | no | `Hamza` | Not used by the app. The server picks the user's company. Disabled by default. |

  **Response:**

  ```json
  {
    "message": {
      "customer": "Hamza",
      "customer_name": "Hamza Trading",
      "tickets": { "open": 3, "waiting_for_you": 1 },
      "my_actions": [
        {
          "name": "ee1p51uomd",
          "text": "Upload VAT registration certificate and CR copy",
          "due": "2026-11-10",
          "days_left": 4,
          "urgency": "normal",
          "project": "PROJ-0029",
          "cta": "upload",
          "reference": { "doctype": "Project", "name": "PROJ-0029" },
          "status": "open",
          "completed_on": null
        }
      ],
      "unread_notifications": 4
    }
  }
  ```

  **Field notes:**

  - `customer_name`: show this, not `customer` (the ID).
  - `tickets.open`: open tickets. A Client User sees only the tickets they raised; a Client Admin sees all of the company's.
  - `tickets.waiting_for_you`: tickets in Waiting on Client or Resolved (waiting for the client to confirm the fix).
  - `my_actions`: a list, not a count. Same items as `get_my_actions`: open actions only, oldest due date first. Use its length for the badge.
  - `my_actions[].cta`: `upload`, `sign_off` or `mark_done` (`review` is no longer sent; such actions come as `mark_done`). `sign_off` actions only reach Client Admins.
  - `my_actions[].urgency`: `emergency`, `urgent`, `normal`, `low`, or null when not set.
  - `my_actions[].due`: `YYYY-MM-DD`, or null when the action has no due date (then `days_left` is null too). Actions without a due date sort first.
  - `my_actions[].project`: the project ID, or null when the action isn't linked to a Project, Task or milestone. Such unlinked actions are still returned.
  - `my_actions[].reference`: `{ "doctype": "Payment Milestone", "name": "<milestone row id>" }` for a sign-off action, otherwise the record the to-do points at (`Project`, `Task`, ...), or null when it points at nothing.
  - `my_actions[].status` is always `open` here and `completed_on` is always null.
  - `unread_notifications`: count of the user's unread notifications, for the bell badge.

  **Method:** GET. The server does not refuse a POST, but use GET.

  **Errors:**

  - **401** (no error_code): token expired or invalid. Refresh once and retry, else sign out.
  - **403** (no error_code): no Authorization header sent.
  - **403** `no_client_linked`: the user isn't linked to any client company.
  - **403** `not_permitted`: `customer` was sent and isn't the user's company.
}
