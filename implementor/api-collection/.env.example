# Copy to .env (gitignored) and fill in. Never commit .env.
# User access token from Auth > Sign in (token.access_token)
TOKEN=
# App token from Auth > Master Token
MASTER_TOKEN=
# Refresh token from Auth > Sign in (token.refresh_token)
REFRESH_TOKEN=
# Password of your TEST user, used by Sign in / Sign up / New password
PASSWORD=
