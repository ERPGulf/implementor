meta {
  name: Servers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/method/implementor.client_api.get_servers
  body: none
  auth: inherit
}

params:query {
  ~customer: Hamza
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("has message", function () {
    expect(res.body).to.have.property("message");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lists the client's hosted servers.
  
  **Endpoint:** `GET /api/method/implementor.client_api.get_servers`  
  **Screen:** Hosting list
  
  **Permission:** Signed-in client user (Client User or Client Admin). Only records of the user's own client company are returned.
  
  **Query parameters:**
  
  | Field | Type | Required | Example | Notes |
  | --- | --- | --- | --- | --- |
  | `customer` | string | no | `Hamza` | Client company. Send only when `me.customers` has more than one entry. Disabled by default. |
  
  **Response (trimmed):**
  
  ```json
  { "message": [ { "name": "s6qivo97hn", "environment": "Production", "provider": "...", "region": "...", "ssl_expiry": "2027-01-10", "ssl_days_left": 73 } ] }
  ```
  
  **Errors:**
  
  - **401:** Token missing, expired or invalid. Refresh once and retry, else sign out.
  - **403:** Not this client's record, or role not allowed.
  
  **Notes:**
  
  - There is no hosting renewal date. Label the date "SSL certificate expires".
}
